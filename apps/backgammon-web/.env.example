# Application
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=xion-testnet-2
NEXT_PUBLIC_TREASURY_ADDRESS=

# Browser sandbox fixtures are enabled only by `next dev`; production builds ignore this.
# NEXT_PUBLIC_E2E_SANDBOX=1

# Funds default to free. Do not infer money support from any other variable.
NEXT_PUBLIC_FUNDS_MODE=free
