{
  "expo": {
    "name": "Backgammon",
    "slug": "backgammon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "backgammon",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.burnt.backgammon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "GCSupportsGameCenter": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0E08"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.burnt.backgammon"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0E08"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bd4a5855-b7e9-4197-b651-f74794d14b86"
      }
    },
    "owner": "burntb"
  }
}
