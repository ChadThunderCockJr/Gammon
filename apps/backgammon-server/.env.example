# Application
PORT=3001
# Production requires an explicit comma-separated list of exact HTTPS origins.
ALLOWED_ORIGINS=http://localhost:3000
SESSION_SECRET=
DATABASE_URL=postgresql://localhost:5432/backgammon
REDIS_URL=redis://localhost:6379
# Production authentication requires AUTH_CHAIN_ID or the attested VERUSD_CHAIN_ID.
# Paid modes always use VERUSD_RPC_URL for grant queries; a different AUTH_RPC_URL
# fails closed. Free-mode production delegation requires an exact approved endpoint.
# Self-signed principals do not need RPC grant configuration.
# AUTH_RPC_URL=
# AUTH_APPROVED_RPC_URL=
# AUTH_CHAIN_ID=xion-testnet-2
# AUTH_DELEGATION_CONTRACT=xion1...
# AUTH_DELEGATION_MESSAGE_KEY=
# Finance actions by delegated Abstraxion signers require a separate, narrowly scoped grant.
# FINANCE_AUTHORIZATION_CONTRACT=xion1...
# FINANCE_AUTHORIZATION_MESSAGE_KEY=authorize_finance_action
# FINANCE_AUTHORIZATION_CODE_CHECKSUM=
# FINANCE_AUTHORIZATION_ADMIN=xion1...
# FINANCE_AUTHORIZATION_MAX_TRANSFER_MICRO_USD=10000000
# Base64 32-byte secp256k1 key; its compressed public key is lowercase hex.
# CASH_OUT_AUTHORIZATION_PRIVATE_KEY=
# CASH_OUT_AUTHORIZATION_PUBLIC_KEY=
# Comma-separated self-signed XION principals authorized for moderation operations.
# Delegated signers are never accepted as moderators. Empty is default-deny.
# MODERATION_OPERATOR_PRINCIPALS=

# Funds default to free. Credentials alone never enable money routes or workers.
FUNDS_MODE=free

# Required manifest for verusd_testnet or verusd_production
# FUNDS_MODE=verusd_testnet
# VERUSD_CHAIN_ID=xion-testnet-2
# VERUSD_GENESIS_BLOCK_HASH=
# VERUSD_RPC_URL=https://rpc.xion-testnet-2.burnt.com:443
# VERUSD_REST_URL=https://api.xion-testnet-2.burnt.com
# VERUSD_DENOM=factory/xion1.../verusd
# VERUSD_SYMBOL=verUSD
# VERUSD_DECIMALS=6
# VERUSD_ESCROW_CONTRACT=xion1...
# VERUSD_ESCROW_CODE_CHECKSUM=
# VERUSD_ESCROW_ADMIN=xion1...
# VERUSD_MIN_STAKE_MICRO_USD=100000
# VERUSD_MAX_STAKE_MICRO_USD=10000000
# VERUSD_FUNDING_TIMEOUT_SECONDS=300
# VERUSD_RAKE_RECIPIENT=xion1...
# VERUSD_FINALITY_BLOCKS=2

# Independent settlement authorizer
# SETTLEMENT_AUTHORIZER_URL=
# SETTLEMENT_AUTHORIZER_API_KEY=
# SETTLEMENT_AUTHORIZER_PUBLIC_KEY=
# SETTLEMENT_AUTHORIZER_SIGNING_KEY_ID=
# SETTLEMENT_AUTHORITY_CONTRACT=xion1...

# Brale and Plaid
# BRALE_API_KEY=
# BRALE_ACCOUNT_ID=
# BRALE_PROGRAM_ID=
# BRALE_REQUIRED_ACCOUNT_CAPABILITY=
# BRALE_API_URL=https://api.brale.xyz
# BRALE_AUTH_URL=https://auth.brale.xyz/oauth2/token
# BRALE_TRANSFER_TYPE=verona_testnet
# BRALE_WEBHOOK_SECRET=
# BRALE_WEBHOOK_SUBSCRIPTION_ID=
# BRALE_WEBHOOK_ENVIRONMENT=
# BRALE_PLAID_WEBHOOK_URL=
# FINANCE_RECONCILIATION_BATCH_SIZE=100

# Versioned JSON key ring for financial and moderation sensitive payloads:
# {"primary":"<Base64-encoded 32-byte key>"}
# FINANCE_DATA_KEY_ID=primary
# FINANCE_DATA_KEYS=
# Stable keyed-hash secret; rotate only with an explicit idempotency migration.
# FINANCE_HASH_KEY=
# FINANCE_DATA_KEY= # non-production legacy fallback only

# Versioned point-of-action consent and reviewed provider documents. Every URL must
# be HTTPS; Brale EUA must resolve under brale.xyz and Plaid privacy under plaid.com.
# SHA-256 values are 64 lowercase hexadecimal characters; expirations are ISO-8601.
# TERMS_VERSION=
# PRIVACY_VERSION=
# BRALE_END_USER_TOS_VERSION=
# BRALE_EUA_URL=https://www.brale.xyz/...
# BRALE_EUA_SHA256=
# BRALE_EUA_EXPIRES_AT=
# PLAID_PRIVACY_VERSION=
# PLAID_PRIVACY_URL=https://plaid.com/legal
# PLAID_PRIVACY_SHA256=
# PLAID_PRIVACY_EXPIRES_AT=
# ACH_AUTHORIZATION_VERSION=
# ACH_AUTHORIZATION_URL=https://...
# ACH_AUTHORIZATION_SHA256=
# ACH_AUTHORIZATION_EXPIRES_AT=
# CUSTODY_DISCLOSURE_VERSION=
# FEE_SCHEDULE_VERSION=
# PAYMENT_TIMING_POLICY_VERSION=
# RESPONSIBLE_PLAY_POLICY_VERSION=
# Approved responsible-play help shown to players entering paid play. It is required
# for production entry only, with a current expiry; recovery remains independently available.
# RESPONSIBLE_PLAY_HELP_NAME=
# RESPONSIBLE_PLAY_HELP_URL=https://...
# RESPONSIBLE_PLAY_HELP_VERSION=
# RESPONSIBLE_PLAY_HELP_SHA256=
# RESPONSIBLE_PLAY_HELP_EXPIRES_AT=
# CASH_GAME_TERMS_VERSION=
# COMPLAINTS_POLICY_VERSION=
# DATA_LIFECYCLE_POLICY_VERSION=
# DATA_RETENTION_SCHEDULE_VERSION=

# Production remains default-deny without current external approvals. Every approved
# identity below must byte-for-byte match its active counterpart before any trusted
# provider or chain request is made.
# VERUSD_APPROVED_CHAIN_ID=
# VERUSD_APPROVED_GENESIS_BLOCK_HASH=
# VERUSD_APPROVED_RPC_URL=
# VERUSD_APPROVED_REST_URL=
# VERUSD_APPROVED_DENOM=
# VERUSD_APPROVED_ESCROW_CONTRACT=
# VERUSD_APPROVED_ESCROW_CODE_CHECKSUM=
# VERUSD_APPROVED_FINALITY_BLOCKS=
# VERUSD_APPROVED_ESCROW_ADMIN=
# VERUSD_APPROVED_RAKE_RECIPIENT=
# VERUSD_APPROVED_MIN_STAKE_MICRO_USD=
# VERUSD_APPROVED_MAX_STAKE_MICRO_USD=
# VERUSD_APPROVED_FUNDING_TIMEOUT_SECONDS=
# SETTLEMENT_AUTHORITY_APPROVED_CONTRACT=
# SETTLEMENT_AUTHORIZER_APPROVED_URL=
# SETTLEMENT_AUTHORIZER_APPROVED_PUBLIC_KEY=
# SETTLEMENT_AUTHORIZER_APPROVED_SIGNING_KEY_ID=
# BRALE_APPROVED_ENVIRONMENT=
# BRALE_APPROVED_API_URL=
# BRALE_APPROVED_AUTH_URL=
# BRALE_APPROVED_ACCOUNT_ID=
# BRALE_APPROVED_PROGRAM_ID=
# BRALE_APPROVED_ACCOUNT_CAPABILITY=
# FINANCE_APPROVED_AUTHORIZATION_CONTRACT=xion1...
# FINANCE_APPROVED_AUTHORIZATION_MESSAGE_KEY=authorize_finance_action
# FINANCE_APPROVED_AUTHORIZATION_CODE_CHECKSUM=
# FINANCE_APPROVED_AUTHORIZATION_ADMIN=xion1...
# FINANCE_APPROVED_AUTHORIZATION_MAX_TRANSFER_MICRO_USD=
# FINANCE_APPROVED_AUTHORIZATION_PUBLIC_KEY=
# BRALE_APPROVED_TRANSFER_TYPE=
# BRALE_APPROVED_PLAID_WEBHOOK_URL=https://...
# BRALE_PROGRAM_APPROVAL_ID=
# WAGERING_PROGRAM_APPROVAL_ID=
# LEGAL_APPROVAL_ID=
# JURISDICTION_POLICY_VERSION=
# AGE_AND_IDENTITY_POLICY_VERSION=
# GEOLOCATION_POLICY_VERSION=
# ELIGIBILITY_POLICY_VERSION=
# LEGACY_RECONCILIATION_ID=
# ACH_AVAILABILITY_POLICY_ID=
# ACH_AVAILABILITY_DELAY_SECONDS=
# ACH_AVAILABILITY_POLICY_EXPIRES_AT=
# ACH_RETURN_RECONCILIATION_HORIZON_SECONDS=
# ACH_APPROVED_AVAILABILITY_DELAY_SECONDS=
# ACH_APPROVED_RETURN_RECONCILIATION_HORIZON_SECONDS=
# PRODUCTION_APPROVAL_EXPIRES_AT=
# PRODUCTION_RECOVERY_APPROVAL_EXPIRES_AT=
#
# Recovery approval is independently default-deny and live-expiring. It does not
# re-open entry-only pause/rake/cap/rules or participant evidence checks.
# PRODUCTION_RECOVERY_APPROVED=false
# PRODUCTION_FUNDS_APPROVED=false
# FUNDS_ENTRY_KILL_SWITCH=false

# Runtime limits
# RATE_LIMIT_WINDOW_MS=1000
# RATE_LIMIT_MAX_MESSAGES=30
# WS_MAX_PAYLOAD_BYTES=16384
# DISCONNECT_GRACE_SEC=30
# DISCONNECT_CHECK_INTERVAL_MS=5000
# DEFAULT_TURN_TIME_LIMIT_SEC=60
# INTER_GAME_DELAY_MS=3000
# ONLINE_HEARTBEAT_TTL_SEC=300
# ONLINE_CLEANUP_INTERVAL_MS=60000
# CHALLENGE_EXPIRY_SEC=60
# MAX_ACTIVITY_ITEMS=50
# GAME_HISTORY_TTL_SEC=31536000
# REDIS_MAX_RETRIES=3
# REDIS_RETRY_DELAY_MIN_MS=500
# REDIS_RETRY_DELAY_MAX_MS=2000
